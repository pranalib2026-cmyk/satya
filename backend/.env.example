# Copy this file to `.env` before running the API.
# Every value below is optional in development; the defaults shown are what the
# server uses when the variable is missing.

# development | test | production
NODE_ENV=development

# Network binding
HOST=0.0.0.0
PORT=4000

# SQLite file, relative to the backend working directory.
# Use `:memory:` for ephemeral databases (tests do this automatically).
DATABASE_URL=./data/nyayasetu.db

# Comma-separated allow-list. Use `*` only for local experiments.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Used in OpenAPI servers and log messages. No trailing slash.
PUBLIC_BASE_URL=http://localhost:4000

# Mount point for all business endpoints.
API_PREFIX=/api/v1

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Global rate limit per client IP.
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute

# Set to false to disable /docs and the OpenAPI document.
ENABLE_SWAGGER=true
